# Database Configuration
MONGO_URL=mongodb+srv://username:password@cluster.mongodb.net/hostel
DB_NAME=hostel_db

# Authentication & Security
JWT_SECRET=your-super-secure-jwt-secret-key-minimum-32-characters-required
